# 複製成 .env.local 後填入金鑰（.env.local 已在 .gitignore 中，不會被上傳）
# 這些變數只在伺服器端（app/api）讀取，前端看不到。

# 大腦：Anthropic Claude API（https://console.anthropic.com）
ANTHROPIC_API_KEY=
# 可選：預設 claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# 聲音：ElevenLabs（https://elevenlabs.io → Developers → API Keys）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 可選：TTS 模型（預設 eleven_multilingual_v2）、STT 模型（預設 scribe_v1）
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# 記憶：OpenAI embeddings（可選；沒填時檢索改用 BM25 關鍵字檢索）
OPENAI_API_KEY=

# 濫用防護：每個 IP 每分鐘可呼叫 /api/chat 的次數（預設 10）
RATE_LIMIT_PER_MINUTE=10

# 可選：設成 off 可關閉「模型拒答時由伺服器自動改用備援模型」
# CLAUDE_FALLBACK=off
